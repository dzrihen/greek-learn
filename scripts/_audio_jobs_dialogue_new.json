[{"text": "Internet υπάρχει. Κατοικίδια κατόπιν συνεννόησης. Ελάτε στις πέντε.", "path": "audio/dialogue/3f9860f9.mp3", "hash": "3f9860f9", "kind": "dialogue"}, {"text": "Άρα μετρό και κόκκινη γραμμή. Ευχαριστώ!", "path": "audio/dialogue/34beba91.mp3", "hash": "34beba91", "kind": "dialogue"}, {"text": "Έλα;", "path": "audio/dialogue/7c99155c.mp3", "hash": "7c99155c", "kind": "dialogue"}, {"text": "Ένα γραμματόσημο, παρακαλώ.", "path": "audio/dialogue/70a3a211.mp3", "hash": "70a3a211", "kind": "dialogue"}, {"text": "Ένα εισιτήριο, παρακαλώ.", "path": "audio/dialogue/4a1d1f27.mp3", "hash": "4a1d1f27", "kind": "dialogue"}, {"text": "Έναν latte με γάλα αμυγδάλου, χωρίς ζάχαρη.", "path": "audio/dialogue/3020d430.mp3", "hash": "3020d430", "kind": "dialogue"}, {"text": "Έτοιμοι για παραγγελία;", "path": "audio/dialogue/6ff26f44.mp3", "hash": "6ff26f44", "kind": "dialogue"}, {"text": "Έχασα το διαβατήριό μου. Θέλω να κάνω καταγγελία.", "path": "audio/dialogue/d14e93f2.mp3", "hash": "d14e93f2", "kind": "dialogue"}, {"text": "Έχει internet;", "path": "audio/dialogue/80580806.mp3", "hash": "80580806", "kind": "dialogue"}, {"text": "Έχει έκπτωση;", "path": "audio/dialogue/b066d033.mp3", "hash": "b066d033", "kind": "dialogue"}, {"text": "Έχετε δίπλωμα και διαβατήριο; Εγγύηση διακόσια ευρώ.", "path": "audio/dialogue/50f8c27a.mp3", "hash": "50f8c27a", "kind": "dialogue"}, {"text": "Έχετε διαβατήριο μαζί σας;", "path": "audio/dialogue/7a7be8a3.mp3", "hash": "7a7be8a3", "kind": "dialogue"}, {"text": "Έχετε κρουασάν;", "path": "audio/dialogue/86d0eef7.mp3", "hash": "86d0eef7", "kind": "dialogue"}, {"text": "Έχετε τζιν σαρανταδύο;", "path": "audio/dialogue/43554a4f.mp3", "hash": "43554a4f", "kind": "dialogue"}, {"text": "Έχουμε αύριο στις τρεις ή την Παρασκευή το πρωί.", "path": "audio/dialogue/287a821.mp3", "hash": "287a821", "kind": "dialogue"}, {"text": "Έχουμε δωρεάν μέρα δοκιμής και πακέτο οκτώ επισκέψεων.", "path": "audio/dialogue/81735a67.mp3", "hash": "81735a67", "kind": "dialogue"}, {"text": "Έχω αλλεργία στους ξηρούς καρπούς.", "path": "audio/dialogue/6ebcaa78.mp3", "hash": "6ebcaa78", "kind": "dialogue"}, {"text": "Όνομα για το ποτήρι;", "path": "audio/dialogue/b489e530.mp3", "hash": "b489e530", "kind": "dialogue"}, {"text": "Όχι προς το παρόν, ευχαριστώ.", "path": "audio/dialogue/14387384.mp3", "hash": "14387384", "kind": "dialogue"}, {"text": "Όχι, ακόμα δεν δουλεύει.", "path": "audio/dialogue/587fbe2.mp3", "hash": "587fbe2", "kind": "dialogue"}, {"text": "Όχι, χωρίς.", "path": "audio/dialogue/ef44b7f7.mp3", "hash": "ef44b7f7", "kind": "dialogue"}, {"text": "Αναπνέει, αλλά αδύναμα.", "path": "audio/dialogue/bccf2bb2.mp3", "hash": "bccf2bb2", "kind": "dialogue"}, {"text": "Από την Αθήνα.", "path": "audio/dialogue/9359c6b3.mp3", "hash": "9359c6b3", "kind": "dialogue"}, {"text": "Από το Ισραήλ.", "path": "audio/dialogue/b3d13a72.mp3", "hash": "b3d13a72", "kind": "dialogue"}, {"text": "Αριθμό για έναν μήνα.", "path": "audio/dialogue/bf07cab3.mp3", "hash": "bf07cab3", "kind": "dialogue"}, {"text": "Ας πάμε σινεμά.", "path": "audio/dialogue/e359555f.mp3", "hash": "e359555f", "kind": "dialogue"}, {"text": "Ας το κάνουμε αύριο στις οκτώ.", "path": "audio/dialogue/45b8cab3.mp3", "hash": "45b8cab3", "kind": "dialogue"}, {"text": "Αστυνομία, παρακαλώ.", "path": "audio/dialogue/d420efab.mp3", "hash": "d420efab", "kind": "dialogue"}, {"text": "Αυτό το λεωφορείο πάει στον σταθμό;", "path": "audio/dialogue/624e77f8.mp3", "hash": "624e77f8", "kind": "dialogue"}, {"text": "Αύριο στις τρεις, παρακαλώ.", "path": "audio/dialogue/66c20954.mp3", "hash": "66c20954", "kind": "dialogue"}, {"text": "Βάζω προτεραιότητες και συντονίζω προσδοκίες από πριν.", "path": "audio/dialogue/65024fb3.mp3", "hash": "65024fb3", "kind": "dialogue"}, {"text": "Γεια σας! Ενδιαφέρεστε για συνδρομή;", "path": "audio/dialogue/823f1800.mp3", "hash": "823f1800", "kind": "dialogue"}, {"text": "Γεια σας! Η παραγγελία σας;", "path": "audio/dialogue/ac05aaf7.mp3", "hash": "ac05aaf7", "kind": "dialogue"}, {"text": "Γεια σας! Με λένε Άννα. Εσάς;", "path": "audio/dialogue/4aa44437.mp3", "hash": "4aa44437", "kind": "dialogue"}, {"text": "Γεια σας! Ποιο πακέτο σας ενδιαφέρει;", "path": "audio/dialogue/723ed667.mp3", "hash": "723ed667", "kind": "dialogue"}, {"text": "Γεια σας! Τι θέλετε;", "path": "audio/dialogue/4f753cf6.mp3", "hash": "4f753cf6", "kind": "dialogue"}, {"text": "Γεια σας! Τι χρειάζεστε;", "path": "audio/dialogue/12a130ab.mp3", "hash": "12a130ab", "kind": "dialogue"}, {"text": "Γεια σας! Τι ψάχνετε;", "path": "audio/dialogue/d87b7e26.mp3", "hash": "d87b7e26", "kind": "dialogue"}, {"text": "Γεια σας, η Άννα παρακαλώ;", "path": "audio/dialogue/dfac82b3.mp3", "hash": "dfac82b3", "kind": "dialogue"}, {"text": "Γεια σας. Αποστολή;", "path": "audio/dialogue/3d9846cd.mp3", "hash": "3d9846cd", "kind": "dialogue"}, {"text": "Γεια σας. Για πόσες μέρες το αυτοκίνητο;", "path": "audio/dialogue/f786535a.mp3", "hash": "f786535a", "kind": "dialogue"}, {"text": "Γεια σας. Πόσα εισιτήρια;", "path": "audio/dialogue/be749ec5.mp3", "hash": "be749ec5", "kind": "dialogue"}, {"text": "Γεια σας. Πώς μπορώ να βοηθήσω;", "path": "audio/dialogue/73d24764.mp3", "hash": "73d24764", "kind": "dialogue"}, {"text": "Γεια! Είμαι ο Δανιήλ. Είσαι ελεύθερος;", "path": "audio/dialogue/3fb3e6ac.mp3", "hash": "3fb3e6ac", "kind": "dialogue"}, {"text": "Γεια! Ναι, είμαι. Τι έγινε;", "path": "audio/dialogue/c57a513a.mp3", "hash": "c57a513a", "kind": "dialogue"}, {"text": "Για Θεσσαλονίκη αύριο.", "path": "audio/dialogue/cdd8448c.mp3", "hash": "cdd8448c", "kind": "dialogue"}, {"text": "Για ποια ταινία;", "path": "audio/dialogue/3405983d.mp3", "hash": "3405983d", "kind": "dialogue"}, {"text": "Για τη βραδινή προβολή κωμωδίας, δύο θέσεις.", "path": "audio/dialogue/6213b225.mp3", "hash": "6213b225", "kind": "dialogue"}, {"text": "Για τρεις μέρες, αυτόματο, οικονομική κατηγορία.", "path": "audio/dialogue/1a72abcd.mp3", "hash": "1a72abcd", "kind": "dialogue"}, {"text": "Δανιήλ.", "path": "audio/dialogue/28195d1f.mp3", "hash": "28195d1f", "kind": "dialogue"}, {"text": "Δεν δουλεύει η θέρμανση.", "path": "audio/dialogue/c67837d1.mp3", "hash": "c67837d1", "kind": "dialogue"}, {"text": "Δεν δουλεύει το internet από το πρωί.", "path": "audio/dialogue/2d746237.mp3", "hash": "2d746237", "kind": "dialogue"}, {"text": "Διαβατήριο, φωτογραφία, ασφάλεια και απόδειξη διεύθυνσης. Έως δέκα εργάσιμες.", "path": "audio/dialogue/31180cf0.mp3", "hash": "31180cf0", "kind": "dialogue"}, {"text": "Διπλό εσπρέσο για πακέτο.", "path": "audio/dialogue/de1540d1.mp3", "hash": "de1540d1", "kind": "dialogue"}, {"text": "Δυστυχώς δεν θα μπορέσουμε να έρθουμε.", "path": "audio/dialogue/867c5972.mp3", "hash": "867c5972", "kind": "dialogue"}, {"text": "Δύο ενήλικες για Πάτρα.", "path": "audio/dialogue/d473d527.mp3", "hash": "d473d527", "kind": "dialogue"}, {"text": "Δύο φορές μετά το φαγητό.", "path": "audio/dialogue/4221f31b.mp3", "hash": "4221f31b", "kind": "dialogue"}, {"text": "Δύο ψωμάκια και μαύρο ψωμί, παρακαλώ.", "path": "audio/dialogue/e3cade83.mp3", "hash": "e3cade83", "kind": "dialogue"}, {"text": "Είκοσι επτά — το ελάχιστο.", "path": "audio/dialogue/8dce1738.mp3", "hash": "8dce1738", "kind": "dialogue"}, {"text": "Είκοσι πέντε είναι εντάξει;", "path": "audio/dialogue/fdae41e7.mp3", "hash": "fdae41e7", "kind": "dialogue"}, {"text": "Είμαι στην οδό Ακαδημίας 10.", "path": "audio/dialogue/dd621877.mp3", "hash": "dd621877", "kind": "dialogue"}, {"text": "Είναι λίγο ακριβό. Μπορεί φθηνότερα;", "path": "audio/dialogue/a5657e2b.mp3", "hash": "a5657e2b", "kind": "dialogue"}, {"text": "Είναι μικρό. Έχετε μεγαλύτερο;", "path": "audio/dialogue/2cffbfd4.mp3", "hash": "2cffbfd4", "kind": "dialogue"}, {"text": "Είναι συνειδητός; Αναπνέει;", "path": "audio/dialogue/3b0eec35.mp3", "hash": "3b0eec35", "kind": "dialogue"}, {"text": "Εκτάκτως. Τι συνέβη;", "path": "audio/dialogue/1fb6954c.mp3", "hash": "1fb6954c", "kind": "dialogue"}, {"text": "Ελπίζω να μην βρέξει.", "path": "audio/dialogue/1508cc23.mp3", "hash": "1508cc23", "kind": "dialogue"}, {"text": "Εντάξει, το παίρνω στα είκοσι επτά.", "path": "audio/dialogue/e319108b.mp3", "hash": "e319108b", "kind": "dialogue"}, {"text": "Εντός δεκατεσσάρων ημερών γίνεται. Μετρητά ή κάρτα;", "path": "audio/dialogue/a203163b.mp3", "hash": "a203163b", "kind": "dialogue"}, {"text": "Επιτρέπονται κατοικίδια;", "path": "audio/dialogue/fdc7eaf4.mp3", "hash": "fdc7eaf4", "kind": "dialogue"}, {"text": "Εστιατόριο Αιγαίο, παρακαλώ.", "path": "audio/dialogue/13e23af7.mp3", "hash": "13e23af7", "kind": "dialogue"}, {"text": "Ευχαριστώ, το εκτιμώ.", "path": "audio/dialogue/e39d730b.mp3", "hash": "e39d730b", "kind": "dialogue"}, {"text": "Ευχαριστώ.", "path": "audio/dialogue/44f1ae3c.mp3", "hash": "44f1ae3c", "kind": "dialogue"}, {"text": "Ευχαριστώ. Ετοιμάσαμε σύντομη επισκόπηση αποτελεσμάτων.", "path": "audio/dialogue/26447885.mp3", "hash": "26447885", "kind": "dialogue"}, {"text": "Ευχαριστώ. Πείτε μου πότε να κατέβω.", "path": "audio/dialogue/565eee37.mp3", "hash": "565eee37", "kind": "dialogue"}, {"text": "Η μουσική είναι δυνατά μετά τις έντεκα.", "path": "audio/dialogue/f7f37c7a.mp3", "hash": "f7f37c7a", "kind": "dialogue"}, {"text": "Θέλεις να βγούμε σήμερα το βράδυ;", "path": "audio/dialogue/fed8e009.mp3", "hash": "fed8e009", "kind": "dialogue"}, {"text": "Θέλω ένα πουκάμισο, μέγεθος M.", "path": "audio/dialogue/433aaa2b.mp3", "hash": "433aaa2b", "kind": "dialogue"}, {"text": "Θέλω να ακυρώσω κράτηση για σήμερα στο όνομα Δανιήλ.", "path": "audio/dialogue/8f71703b.mp3", "hash": "8f71703b", "kind": "dialogue"}, {"text": "Θέλω να ανοίξω λογαριασμό.", "path": "audio/dialogue/d62feb57.mp3", "hash": "d62feb57", "kind": "dialogue"}, {"text": "Θέλω να βγάλω χρήματα.", "path": "audio/dialogue/e798538f.mp3", "hash": "e798538f", "kind": "dialogue"}, {"text": "Θέλω να ενισχύσω διαπραγμάτευση και παρουσιάσεις.", "path": "audio/dialogue/4acb18be.mp3", "hash": "4acb18be", "kind": "dialogue"}, {"text": "Θέλω να επιστρέψω αυτό το μπουφάν. Ορίστε η απόδειξη.", "path": "audio/dialogue/a7ba04c6.mp3", "hash": "a7ba04c6", "kind": "dialogue"}, {"text": "Θα ήθελα να κλείσω ραντεβού.", "path": "audio/dialogue/9d5918ca.mp3", "hash": "9d5918ca", "kind": "dialogue"}, {"text": "Θα ανοίξω αίτημα. Τεχνικός αύριο 12–16.", "path": "audio/dialogue/48de1dcd.mp3", "hash": "48de1dcd", "kind": "dialogue"}, {"text": "Θα πάρω το πακέτο των οκτώ.", "path": "audio/dialogue/f9a29ebf.mp3", "hash": "f9a29ebf", "kind": "dialogue"}, {"text": "Κάθεται τέλεια. Πόσο κάνει;", "path": "audio/dialogue/8f642a7f.mp3", "hash": "8f642a7f", "kind": "dialogue"}, {"text": "Κάντε επανεκκίνηση. Βοήθησε;", "path": "audio/dialogue/ec77f22d.mp3", "hash": "ec77f22d", "kind": "dialogue"}, {"text": "Κάποιος δεν αισθάνεται καλά, χρειάζεται βοήθεια.", "path": "audio/dialogue/7733fade.mp3", "hash": "7733fade", "kind": "dialogue"}, {"text": "Κάτι για τον πονοκέφαλο, παρακαλώ.", "path": "audio/dialogue/959de5d7.mp3", "hash": "959de5d7", "kind": "dialogue"}, {"text": "Και στο επαγγελματικό email;", "path": "audio/dialogue/58528cf4.mp3", "hash": "58528cf4", "kind": "dialogue"}, {"text": "Καλά, ευχαριστώ. Εσείς;", "path": "audio/dialogue/db027959.mp3", "hash": "db027959", "kind": "dialogue"}, {"text": "Καλημέρα! Τι κάνετε;", "path": "audio/dialogue/bd8e248b.mp3", "hash": "bd8e248b", "kind": "dialogue"}, {"text": "Καλημέρα. Ας δούμε το πλάνο της εβδομάδας.", "path": "audio/dialogue/84faeb3b.mp3", "hash": "84faeb3b", "kind": "dialogue"}, {"text": "Καλημέρα. Πώς μπορώ να βοηθήσω;", "path": "audio/dialogue/7793f6fc.mp3", "hash": "7793f6fc", "kind": "dialogue"}, {"text": "Καλημέρα. Φεύγετε σήμερα;", "path": "audio/dialogue/c300b8b.mp3", "hash": "c300b8b", "kind": "dialogue"}, {"text": "Καλύτερα να ευχαριστήσουμε και να προτείνουμε εναλλακτική αργότερα.", "path": "audio/dialogue/b9744bd9.mp3", "hash": "b9744bd9", "kind": "dialogue"}, {"text": "Κανονικά, λίγο κουρασμένος.", "path": "audio/dialogue/2d2082e6.mp3", "hash": "2d2082e6", "kind": "dialogue"}, {"text": "Κατάλαβα. Μπορώ να στείλω τεχνικό αύριο το πρωί.", "path": "audio/dialogue/509da203.mp3", "hash": "509da203", "kind": "dialogue"}, {"text": "Καταλαβαίνω. Ψάρι με λαχανικά — χωρίς ξηρούς καρπούς.", "path": "audio/dialogue/c98d38e6.mp3", "hash": "c98d38e6", "kind": "dialogue"}, {"text": "Κι εγώ καλά. Ωραίος καιρός σήμερα.", "path": "audio/dialogue/e3a94010.mp3", "hash": "e3a94010", "kind": "dialogue"}, {"text": "Κλειδί και μίνι μπαρ — όλα εντάξει;", "path": "audio/dialogue/e2340f61.mp3", "hash": "e2340f61", "kind": "dialogue"}, {"text": "Κρίμα. Ακυρώνω. Να το μεταφέρουμε για αύριο;", "path": "audio/dialogue/55742d60.mp3", "hash": "55742d60", "kind": "dialogue"}, {"text": "Λέγετε; Τι έγινε;", "path": "audio/dialogue/7f7efaf6.mp3", "hash": "7f7efaf6", "kind": "dialogue"}, {"text": "Λίγο. Μαθαίνω ελληνικά.", "path": "audio/dialogue/711f4f32.mp3", "hash": "711f4f32", "kind": "dialogue"}, {"text": "Μέτριο ή μεγάλο;", "path": "audio/dialogue/6e71950.mp3", "hash": "6e71950", "kind": "dialogue"}, {"text": "Μέτριο, παρακαλώ.", "path": "audio/dialogue/e72eee8a.mp3", "hash": "e72eee8a", "kind": "dialogue"}, {"text": "Μέχρι τις δώδεκα, ναι.", "path": "audio/dialogue/12a921d3.mp3", "hash": "12a921d3", "kind": "dialogue"}, {"text": "Με έκλεψαν.", "path": "audio/dialogue/ff1d391f.mp3", "hash": "ff1d391f", "kind": "dialogue"}, {"text": "Με ελκύει η ανάπτυξη σε διεθνή ομάδα.", "path": "audio/dialogue/512ead87.mp3", "hash": "512ead87", "kind": "dialogue"}, {"text": "Με κάρτα.", "path": "audio/dialogue/3c484ac0.mp3", "hash": "3c484ac0", "kind": "dialogue"}, {"text": "Με λένε Δανιήλ.", "path": "audio/dialogue/3cafc608.mp3", "hash": "3cafc608", "kind": "dialogue"}, {"text": "Με χαρά. Γράψε μου.", "path": "audio/dialogue/5628ccb2.mp3", "hash": "5628ccb2", "kind": "dialogue"}, {"text": "Μείνετε στη γραμμή. Το ασθενοφόρο έρχεται.", "path": "audio/dialogue/7d841807.mp3", "hash": "7d841807", "kind": "dialogue"}, {"text": "Μεγάλο.", "path": "audio/dialogue/6cddc079.mp3", "hash": "6cddc079", "kind": "dialogue"}, {"text": "Μερικές φορές. Μου αρέσει η περιοχή.", "path": "audio/dialogue/cf20d9ce.mp3", "hash": "cf20d9ce", "kind": "dialogue"}, {"text": "Μετά το φαγητό;", "path": "audio/dialogue/6afebb3f.mp3", "hash": "6afebb3f", "kind": "dialogue"}, {"text": "Μετρητά ή κάρτα;", "path": "audio/dialogue/a9cd49e1.mp3", "hash": "a9cd49e1", "kind": "dialogue"}, {"text": "Μετρητά.", "path": "audio/dialogue/fe69d2b8.mp3", "hash": "fe69d2b8", "kind": "dialogue"}, {"text": "Μηνιαία κάρτα.", "path": "audio/dialogue/58fd7b49.mp3", "hash": "58fd7b49", "kind": "dialogue"}, {"text": "Μια SIM για τουρίστα, με internet.", "path": "audio/dialogue/681a38eb.mp3", "hash": "681a38eb", "kind": "dialogue"}, {"text": "Μου αρέσει να περπατάω και να βλέπω ταινίες.", "path": "audio/dialogue/6ec1a18d.mp3", "hash": "6ec1a18d", "kind": "dialogue"}, {"text": "Μπορείτε να μου δείξετε τον δρόμο για την Ακρόπολη;", "path": "audio/dialogue/bf2b7255.mp3", "hash": "bf2b7255", "kind": "dialogue"}, {"text": "Μπορούμε να ζητήσουμε άλλες δύο μέρες.", "path": "audio/dialogue/d1e714df.mp3", "hash": "d1e714df", "kind": "dialogue"}, {"text": "Μπορούμε φύση, αν δεν βρέξει.", "path": "audio/dialogue/19dc299d.mp3", "hash": "19dc299d", "kind": "dialogue"}, {"text": "Μπορώ να το δω αύριο;", "path": "audio/dialogue/144bbd83.mp3", "hash": "144bbd83", "kind": "dialogue"}, {"text": "Μπορώ να υποβάλω online;", "path": "audio/dialogue/134d7b07.mp3", "hash": "134d7b07", "kind": "dialogue"}, {"text": "Ναι, αλλά είναι πολύ χλωμός.", "path": "audio/dialogue/cb7815ae.mp3", "hash": "cb7815ae", "kind": "dialogue"}, {"text": "Ναι, αρκετά καλά.", "path": "audio/dialogue/5e9d8299.mp3", "hash": "5e9d8299", "kind": "dialogue"}, {"text": "Ναι, για έναν μήνα με βάρη.", "path": "audio/dialogue/9bba9aea.mp3", "hash": "9bba9aea", "kind": "dialogue"}, {"text": "Ναι, δέκα τοις εκατό μέχρι την Κυριακή.", "path": "audio/dialogue/c2994694.mp3", "hash": "c2994694", "kind": "dialogue"}, {"text": "Ναι, δούλεψε. Ευχαριστώ!", "path": "audio/dialogue/fc9c95d1.mp3", "hash": "fc9c95d1", "kind": "dialogue"}, {"text": "Ναι, είναι ακόμα διαθέσιμο το διαμέρισμα;", "path": "audio/dialogue/b6905892.mp3", "hash": "b6905892", "kind": "dialogue"}, {"text": "Ναι, θέλω να στείλω δέμα στο Ισραήλ.", "path": "audio/dialogue/bd793585.mp3", "hash": "bd793585", "kind": "dialogue"}, {"text": "Ναι, με ασφάλεια παρακαλώ.", "path": "audio/dialogue/1c6a4dba.mp3", "hash": "1c6a4dba", "kind": "dialogue"}, {"text": "Ναι, μπορώ να κάνω early check-out;", "path": "audio/dialogue/1e2cd63.mp3", "hash": "1e2cd63", "kind": "dialogue"}, {"text": "Ναι, ορίστε το διαβατήριο.", "path": "audio/dialogue/22414178.mp3", "hash": "22414178", "kind": "dialogue"}, {"text": "Ναι, ορίστε. Η εγγύηση με κάρτα γίνεται;", "path": "audio/dialogue/f73a495.mp3", "hash": "f73a495", "kind": "dialogue"}, {"text": "Ναι, πολύ ζεστά.", "path": "audio/dialogue/8d698913.mp3", "hash": "8d698913", "kind": "dialogue"}, {"text": "Ναι, πού είναι το ψωμί και το γάλα;", "path": "audio/dialogue/8553234f.mp3", "hash": "8553234f", "kind": "dialogue"}, {"text": "Ναι, σε τέσσερις στάσεις.", "path": "audio/dialogue/8dfdac04.mp3", "hash": "8dfdac04", "kind": "dialogue"}, {"text": "Ναι, σειρά εφτά, θέσεις δέκα και έντεκα.", "path": "audio/dialogue/1d7a36d5.mp3", "hash": "1d7a36d5", "kind": "dialogue"}, {"text": "Ναι, φρέσκα. Κάτι άλλο;", "path": "audio/dialogue/534676d3.mp3", "hash": "534676d3", "kind": "dialogue"}, {"text": "Ναι. Διακόσια τη μέρα, εγγύηση μία εβδομάδα.", "path": "audio/dialogue/f3b7adef.mp3", "hash": "f3b7adef", "kind": "dialogue"}, {"text": "Ναι; Πώς μπορώ να βοηθήσω;", "path": "audio/dialogue/4fc0579a.mp3", "hash": "4fc0579a", "kind": "dialogue"}, {"text": "Ο δρομολογητής αναβοσβήνει κόκκινο.", "path": "audio/dialogue/3cc94086.mp3", "hash": "3cc94086", "kind": "dialogue"}, {"text": "Ο κύριος κίνδυνος είναι καθυστερήσεις από προμηθευτές.", "path": "audio/dialogue/7cc452dd.mp3", "hash": "7cc452dd", "kind": "dialogue"}, {"text": "Ο πελάτης ζητά να μεταφέρουμε την προθεσμία στην Παρασκευή.", "path": "audio/dialogue/efda54d0.mp3", "hash": "efda54d0", "kind": "dialogue"}, {"text": "Οδοντιατρείο, γεια σας.", "path": "audio/dialogue/f80bb5fc.mp3", "hash": "f80bb5fc", "kind": "dialogue"}, {"text": "Ορίστε το κλειδί. Δεν άγγιξα το μίνι μπαρ.", "path": "audio/dialogue/c5aea20d.mp3", "hash": "c5aea20d", "kind": "dialogue"}, {"text": "Ορίστε, δοκιμάστε αριστερά.", "path": "audio/dialogue/67371198.mp3", "hash": "67371198", "kind": "dialogue"}, {"text": "Ορίστε. Οι οδηγίες είναι στη συσκευασία.", "path": "audio/dialogue/d39e198b.mp3", "hash": "d39e198b", "kind": "dialogue"}, {"text": "Ορίστε. Περάστε από την πύλη.", "path": "audio/dialogue/bbdaf3e.mp3", "hash": "bbdaf3e", "kind": "dialogue"}, {"text": "Πάμε για καφέ στις έξι.", "path": "audio/dialogue/df0434a3.mp3", "hash": "df0434a3", "kind": "dialogue"}, {"text": "Πέντε χρόνια εργάστηκα στο μάρκετινγκ με μεγάλες καμπάνιες.", "path": "audio/dialogue/39d144f1.mp3", "hash": "39d144f1", "kind": "dialogue"}, {"text": "Παρακαλώ; Για την αγγελία;", "path": "audio/dialogue/4ffcdbce.mp3", "hash": "4ffcdbce", "kind": "dialogue"}, {"text": "Παρακεταμόλη, σας παρακαλώ.", "path": "audio/dialogue/d7fefbef.mp3", "hash": "d7fefbef", "kind": "dialogue"}, {"text": "Πείτε μας για την εμπειρία και τα κίνητρά σας.", "path": "audio/dialogue/1b704601.mp3", "hash": "1b704601", "kind": "dialogue"}, {"text": "Πηγαίνετε μέχρι το μετρό και δύο στάσεις στην κόκκινη γραμμή.", "path": "audio/dialogue/ec861a8a.mp3", "hash": "ec861a8a", "kind": "dialogue"}, {"text": "Πιστεύω ότι πέτυχα τους βασικούς στόχους και βελτίωσα διαδικασίες.", "path": "audio/dialogue/955a24ab.mp3", "hash": "955a24ab", "kind": "dialogue"}, {"text": "Ποια έγγραφα χρειάζονται για παράταση βίζας;", "path": "audio/dialogue/7314aae3.mp3", "hash": "7314aae3", "kind": "dialogue"}, {"text": "Ποιοι κίνδυνοι υπάρχουν;", "path": "audio/dialogue/ea3f2dd4.mp3", "hash": "ea3f2dd4", "kind": "dialogue"}, {"text": "Πονάει το δόντι μου.", "path": "audio/dialogue/c3af02cc.mp3", "hash": "c3af02cc", "kind": "dialogue"}, {"text": "Πού είναι η επόμενη στάση;", "path": "audio/dialogue/42087b11.mp3", "hash": "42087b11", "kind": "dialogue"}, {"text": "Πού είναι το ταμείο;", "path": "audio/dialogue/ce26c154.mp3", "hash": "ce26c154", "kind": "dialogue"}, {"text": "Πού θέλετε εισιτήριο;", "path": "audio/dialogue/89f4dfd.mp3", "hash": "89f4dfd", "kind": "dialogue"}, {"text": "Προτείνω να γράψουμε ότι θα στείλουμε πρόχειρο την Τετάρτη.", "path": "audio/dialogue/b16c95a6.mp3", "hash": "b16c95a6", "kind": "dialogue"}, {"text": "Πρωί ή βράδυ;", "path": "audio/dialogue/96da3b79.mp3", "hash": "96da3b79", "kind": "dialogue"}, {"text": "Πρωί, παρακαλώ.", "path": "audio/dialogue/f81e505f.mp3", "hash": "f81e505f", "kind": "dialogue"}, {"text": "Πρόσθεσε μια ευγενική συγγνώμη για την καθυστέρηση.", "path": "audio/dialogue/d2230859.mp3", "hash": "d2230859", "kind": "dialogue"}, {"text": "Πρώτη φορά, μου το πρότειναν φίλοι.", "path": "audio/dialogue/a6728272.mp3", "hash": "a6728272", "kind": "dialogue"}, {"text": "Πόσες φορές τη μέρα;", "path": "audio/dialogue/a2294a03.mp3", "hash": "a2294a03", "kind": "dialogue"}, {"text": "Πόσο διαρκεί η εξέταση;", "path": "audio/dialogue/fafde223.mp3", "hash": "fafde223", "kind": "dialogue"}, {"text": "Πόσο κάνει το γάλα;", "path": "audio/dialogue/46811627.mp3", "hash": "46811627", "kind": "dialogue"}, {"text": "Πότε και πού έγινε;", "path": "audio/dialogue/2cd8bc4c.mp3", "hash": "2cd8bc4c", "kind": "dialogue"}, {"text": "Πώς αξιολογείτε τη δουλειά σας το τρίμηνο;", "path": "audio/dialogue/b8fa4f09.mp3", "hash": "b8fa4f09", "kind": "dialogue"}, {"text": "Πώς αρνούμαστε ευγενικά μια πρόταση;", "path": "audio/dialogue/dab7d74e.mp3", "hash": "dab7d74e", "kind": "dialogue"}, {"text": "Πώς διαχειρίζεστε το άγχος και τις προθεσμίες;", "path": "audio/dialogue/c37183d.mp3", "hash": "c37183d", "kind": "dialogue"}, {"text": "Πώς θα απαντήσουμε για τις προθεσμίες;", "path": "audio/dialogue/a4b3676c.mp3", "hash": "a4b3676c", "kind": "dialogue"}, {"text": "Σήμερα το πρωί στο μετρό.", "path": "audio/dialogue/7103aa9b.mp3", "hash": "7103aa9b", "kind": "dialogue"}, {"text": "Σινεμά ακούγεται ωραία. Τι ώρα;", "path": "audio/dialogue/b70220e5.mp3", "hash": "b70220e5", "kind": "dialogue"}, {"text": "Στην κάρτα, παρακαλώ.", "path": "audio/dialogue/83d4e357.mp3", "hash": "83d4e357", "kind": "dialogue"}, {"text": "Στις εφτά το βράδυ έξω από τον κινηματογράφο.", "path": "audio/dialogue/8648b500.mp3", "hash": "8648b500", "kind": "dialogue"}, {"text": "Στο μπάνιο στάζει η βρύση δύο μέρες.", "path": "audio/dialogue/4cbe6c35.mp3", "hash": "4cbe6c35", "kind": "dialogue"}, {"text": "Συγγνώμη για την ενόχληση. Είναι αργά, μπορεί λίγο πιο χαμηλά;", "path": "audio/dialogue/6322be20.mp3", "hash": "6322be20", "kind": "dialogue"}, {"text": "Συγγνώμη, έχω χαθεί. Πού είναι η οδός Ερμού;", "path": "audio/dialogue/13215da0.mp3", "hash": "13215da0", "kind": "dialogue"}, {"text": "Συμπληρώστε τη φόρμα. Θέλετε ασφάλεια;", "path": "audio/dialogue/68b1f37a.mp3", "hash": "68b1f37a", "kind": "dialogue"}, {"text": "Συμπληρώστε τη φόρμα. Ορίστε αντίγραφο για την πρεσβεία.", "path": "audio/dialogue/778b9dfe.mp3", "hash": "778b9dfe", "kind": "dialogue"}, {"text": "Τέλεια! Στις έξι στο μετρό Σύνταγμα.", "path": "audio/dialogue/887551b3.mp3", "hash": "887551b3", "kind": "dialogue"}, {"text": "Τέλεια, θα είμαι σπίτι από τις δέκα.", "path": "audio/dialogue/93d5ef0e.mp3", "hash": "93d5ef0e", "kind": "dialogue"}, {"text": "Τέλεια, τα παίρνω.", "path": "audio/dialogue/495cbb6.mp3", "hash": "495cbb6", "kind": "dialogue"}, {"text": "Τέλεια, τότε το ψάρι.", "path": "audio/dialogue/d96eb776.mp3", "hash": "d96eb776", "kind": "dialogue"}, {"text": "Τα κοινόχρηστα περιλαμβάνονται;", "path": "audio/dialogue/5765bb7.mp3", "hash": "5765bb7", "kind": "dialogue"}, {"text": "Τελείωσα την αναφορά. Μπορώ να τη δείξω σήμερα.", "path": "audio/dialogue/f707e0d7.mp3", "hash": "f707e0d7", "kind": "dialogue"}, {"text": "Την Παρασκευή το πρωί είναι καλύτερα.", "path": "audio/dialogue/19c12acc.mp3", "hash": "19c12acc", "kind": "dialogue"}, {"text": "Τι θέλετε να αναπτύξετε στη συνέχεια;", "path": "audio/dialogue/499761b7.mp3", "hash": "499761b7", "kind": "dialogue"}, {"text": "Τι κάνουμε το Σάββατο;", "path": "audio/dialogue/fdcefb45.mp3", "hash": "fdcefb45", "kind": "dialogue"}, {"text": "Τι σου αρέσει να κάνεις στον ελεύθερο χρόνο;", "path": "audio/dialogue/7c3d9949.mp3", "hash": "7c3d9949", "kind": "dialogue"}, {"text": "Τι ώρα είναι το πρωινό;", "path": "audio/dialogue/c7e05889.mp3", "hash": "c7e05889", "kind": "dialogue"}, {"text": "Το βραδινό είναι φθηνότερο;", "path": "audio/dialogue/7d6a5e3.mp3", "hash": "7d6a5e3", "kind": "dialogue"}, {"text": "Το μέγεθος δεν μου πήγε.", "path": "audio/dialogue/8d929930.mp3", "hash": "8d929930", "kind": "dialogue"}, {"text": "Το παίρνω. Με κάρτα.", "path": "audio/dialogue/29fec69e.mp3", "hash": "29fec69e", "kind": "dialogue"}, {"text": "Το παίρνω. Χρειάζεται διαβατήριο;", "path": "audio/dialogue/724bc1bb.mp3", "hash": "724bc1bb", "kind": "dialogue"}, {"text": "Το ψωμί στον διάδρομο δύο, το γάλα στο ψυγείο δεξιά.", "path": "audio/dialogue/c52e95a2.mp3", "hash": "c52e95a2", "kind": "dialogue"}, {"text": "Υπάρχει δοκιμαστικό μάθημα;", "path": "audio/dialogue/81412062.mp3", "hash": "81412062", "kind": "dialogue"}, {"text": "Υπάρχει πακέτο 15GB για δεκαπέντε ευρώ.", "path": "audio/dialogue/ce615d1b.mp3", "hash": "ce615d1b", "kind": "dialogue"}, {"text": "Υπάρχει πρωί. Θέση δίπλα στο παράθυρο.", "path": "audio/dialogue/79b311f6.mp3", "hash": "79b311f6", "kind": "dialogue"}, {"text": "Υπάρχουν θέσεις στο κέντρο;", "path": "audio/dialogue/4fbacca6.mp3", "hash": "4fbacca6", "kind": "dialogue"}, {"text": "Υποστήριξη πελατών, γεια σας.", "path": "audio/dialogue/5f4aa633.mp3", "hash": "5f4aa633", "kind": "dialogue"}, {"text": "Φυσικά. Θα το δείξω πριν την αποστολή.", "path": "audio/dialogue/fe0d5729.mp3", "hash": "fe0d5729", "kind": "dialogue"}, {"text": "Χάρηκα πολύ.", "path": "audio/dialogue/33e794b4.mp3", "hash": "33e794b4", "kind": "dialogue"}, {"text": "Χάρηκα που σας βλέπω. Ας ξεκινήσουμε από τους στόχους.", "path": "audio/dialogue/64ddf2d9.mp3", "hash": "64ddf2d9", "kind": "dialogue"}, {"text": "Χάρηκα! Από πού είστε;", "path": "audio/dialogue/b632c70e.mp3", "hash": "b632c70e", "kind": "dialogue"}, {"text": "Χάρηκα. Έρχεσαι συχνά εδώ;", "path": "audio/dialogue/f20a1a29.mp3", "hash": "f20a1a29", "kind": "dialogue"}, {"text": "Χθες το βράδυ στο ξενοδοχείο.", "path": "audio/dialogue/ccedeeee.mp3", "hash": "ccedeeee", "kind": "dialogue"}, {"text": "Χρειάζομαι GPS.", "path": "audio/dialogue/b3d80a34.mp3", "hash": "b3d80a34", "kind": "dialogue"}, {"text": "Χρειάζομαι ακόμα δύο μέρες.", "path": "audio/dialogue/31f3499b.mp3", "hash": "31f3499b", "kind": "dialogue"}, {"text": "Χρειάζονται ήπιες φόρμουλες και σαφές επόμενο βήμα.", "path": "audio/dialogue/502952de.mp3", "hash": "502952de", "kind": "dialogue"}, {"text": "Χωρίς γλουτένη, παρακαλώ.", "path": "audio/dialogue/7103736b.mp3", "hash": "7103736b", "kind": "dialogue"}, {"text": "Ωραία! Μιλάτε ελληνικά;", "path": "audio/dialogue/e103344b.mp3", "hash": "e103344b", "kind": "dialogue"}, {"text": "Ωραία. Και για τον πελάτη υπάρχουν νέα;", "path": "audio/dialogue/c1b21380.mp3", "hash": "c1b21380", "kind": "dialogue"}, {"text": "Ωραία. Καλό ταξίδι!", "path": "audio/dialogue/a45f1e58.mp3", "hash": "a45f1e58", "kind": "dialogue"}, {"text": "Ωραία. Μήπως να πάμε σε μια έκθεση κάποια στιγμή;", "path": "audio/dialogue/9a15e7f5.mp3", "hash": "9a15e7f5", "kind": "dialogue"}, {"text": "Ωραίο σακάκι, τριάντα ευρώ.", "path": "audio/dialogue/fb8f508e.mp3", "hash": "fb8f508e", "kind": "dialogue"}, {"text": "Ωχ, συγγνώμη! Αμέσως πιο χαμηλά.", "path": "audio/dialogue/9c189b2.mp3", "hash": "9c189b2", "kind": "dialogue"}]